# ==============================================================================
# STUDENT CAREER PLATFORM — BACKEND PRODUCTION ENVIRONMENT (.env.example)
# Note: For Render deployment, configure these in the Render Dashboard Environment tab.
# No real secrets should be committed to source control.
# ==============================================================================

# Application Environment & Runtime
ENVIRONMENT=production
PORT=10000
DEBUG=False

# Production CORS & Frontend URL
# Current single-service production origin plus local Vite development origins.
# Supports comma-separated URLs or JSON array format.
ALLOWED_ORIGINS=https://careerplatform.onrender.com,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=https://careerplatform.onrender.com

# Database Configuration (PostgreSQL)
# Async driver (postgresql+asyncpg) for FastAPI async endpoints
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>?ssl=require

# Synchronous driver (postgresql) for Alembic schema migrations
# Optional override. Omit to derive it automatically from DATABASE_URL:
# SYNC_DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<dbname>?sslmode=require

# Authentication & Security
# Generate a cryptographically secure 64+ char key using: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_character_hex_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_USERNAME=pranay
ADMIN_EMAIL=pranay@careerplatform.com
# Provision the admin password privately: py scripts/provision_admin.py

# Google Authentication (OAuth2 / Google Cloud Identity Services)
# Web Client ID created in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_cloud_client_id.apps.googleusercontent.com

# Transactional Email Provider (password resets, notifications, optional verification)
# Options: "smtp", "resend", "sendgrid", or "console" (for testing)
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@careerplatform.com
EMAIL_API_KEY=

# SMTP Credentials (Used when EMAIL_PROVIDER=smtp)
# Example Gmail App Password, AWS SES, Brevo, or SendGrid SMTP:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# OTP Expiry & Security Policy
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Google Gemini AI (Backend Only — Never expose to client)
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro

# Cloud Object Storage (Cloudflare R2 / AWS S3)
STORAGE_PROVIDER=database
STORAGE_BUCKET=student-career-platform-uploads
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT_URL=
