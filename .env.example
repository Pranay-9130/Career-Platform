# ==============================================================================
# STUDENT CAREER PLATFORM — MONOREPO ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to appropriate .env files. Never commit actual secret keys.
# ==============================================================================

# Backend Service Configuration (Render)
ENVIRONMENT=production
PORT=10000
DEBUG=False
ALLOWED_ORIGINS=https://aspirepath.vercel.app,https://careerplatform.onrender.com,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=https://aspirepath.vercel.app

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>?ssl=require
# Optional override; otherwise automatically derived from DATABASE_URL:
# SYNC_DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<dbname>?sslmode=require

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_64_character_hex_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_USERNAME=pranay
ADMIN_EMAIL=pranay@careerplatform.com
# Provision the admin password privately from backend: py scripts/provision_admin.py

# Google Identity Services web client (public identifier; backend validates audience)
GOOGLE_CLIENT_ID=your_google_cloud_client_id.apps.googleusercontent.com

# Email Provider Configuration (password resets, notifications, optional verification)
# Options: "smtp", "resend", "sendgrid", "console"
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@careerplatform.com
EMAIL_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# OTP Policy
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# AI Integration (Strictly Backend Only)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Cloud Object Storage
STORAGE_PROVIDER=database
STORAGE_BUCKET=student-career-platform-uploads
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT_URL=

# Frontend Configuration (Vercel)
# First configure the frontend proxy with npm run configure:deployment -- <backend-https-origin>
VITE_API_BASE_URL=https://careerplatform-api.onrender.com/api
VITE_APP_ENV=production
