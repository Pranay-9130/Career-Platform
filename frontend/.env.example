# ==============================================================================
# STUDENT CAREER PLATFORM — FRONTEND PRODUCTION ENVIRONMENT (.env.example)
# Note: For Vercel deployment, configure these in the Vercel Dashboard -> Settings -> Environment Variables.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ==============================================================================

# Backend API Base URL
# Configure the Vercel same-origin proxy before deployment:
# npm run configure:deployment -- https://YOUR-BACKEND.onrender.com
VITE_API_BASE_URL=/api

# Google Sign-In (OAuth2 Web Client ID)
# Obtained from Google Cloud Console -> APIs & Services -> Credentials
# Must include your temporary Vercel URL in Authorized JavaScript Origins
VITE_GOOGLE_CLIENT_ID=your_google_cloud_client_id.apps.googleusercontent.com

# Frontend Application Environment
VITE_APP_ENV=production
