# ==============================================================================
# STUDENT CAREER PLATFORM — FRONTEND PRODUCTION ENVIRONMENT (.env.example)
# Note: For Vercel deployment, configure these in the Vercel Dashboard -> Settings -> Environment Variables.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ==============================================================================

# Backend API Base URL
# Current separately hosted Render API. Use /api only when a same-origin proxy
# or the single-service Docker deployment serves both frontend and backend.
VITE_API_BASE_URL=https://careerplatform-api.onrender.com/api

# Google Sign-In gets its public client ID at runtime from /api/auth/config.
# Configure GOOGLE_CLIENT_ID only on the backend; no client secret is used here.

# Frontend Application Environment
VITE_APP_ENV=production
